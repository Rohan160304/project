  ADVANCE
  FINAL
  DEPOSIT_REFUND
}

model DharamshalaBooking {
  id              String                   @id @default(cuid())
  publicId        String                   @unique
  organizationId  String
  memberId        String
  source          BookingSource            @default(APP)
  bookingType     String                   @default("MEMBER") // MEMBER, VIP, MONK, TRUST, MAINTENANCE
  fromDate        DateTime
  toDate          DateTime
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  numberOfRooms   Int                      @default(1)
  numberOfPersons Int                      @default(1)
  totalAmount     Decimal                  @default(0) @db.Decimal(12, 2)
  depositAmount   Decimal                  @default(0) @db.Decimal(12, 2)
  discount        Decimal                  @default(0) @db.Decimal(12, 2)
  vehicleNumber   String?
  remarks         String?
  status          DharamshalaBookingStatus @default(PENDING)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  member          Member                   @relation(fields: [memberId], references: [id])
  organization    Organization             @relation(fields: [organizationId], references: [id])

  allocations BookingAllocation[]
  payments    PaymentRecord[]

  @@index([organizationId, fromDate])
  @@index([memberId])
  @@map("dharamshala_bookings")
}

enum PathshalaBookingStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

model PathshalaBooking {
  id              String                 @id @default(cuid())
  publicId        String                 @unique
  organizationId  String
  memberId        String
  date            DateTime
  numberOfPersons Int                    @default(1)
  status          PathshalaBookingStatus @default(REGISTERED)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  member          Member                 @relation(fields: [memberId], references: [id])
  organization    Organization           @relation(fields: [organizationId], references: [id])

  @@index([organizationId, date])
  @@index([memberId])
  @@map("pathshala_bookings")
}

model BookingAllocation {
  id             String             @id @default(cuid())
  bookingId      String
  roomOrHallId   String
  startDate      DateTime
  endDate        DateTime
  numberOfGuests Int                @default(1)
  booking        DharamshalaBooking @relation(fields: [bookingId], references: [id])
  roomOrHall     RoomOrHall         @relation(fields: [roomOrHallId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([bookingId])
  @@index([roomOrHallId])
  @@map("booking_allocations")
}

model PaymentRecord {
  id             String             @id @default(cuid())
  bookingId      String
  amount         Decimal            @db.Decimal(12, 2)
  mode           PaymentMode        @default(CASH)
  type           PaymentType        @default(FINAL)
  receiptUrl     String?
  transactionRef String?
  booking        DharamshalaBooking @relation(fields: [bookingId], references: [id])
  createdAt      DateTime           @default(now())

  @@index([bookingId])
  @@map("payment_records")
}

model DharamshalaSettings {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  trustName          String?
  bankDetails        String?
  upiDetails         String?
  cancellationPolicy String?      @db.Text
  receiptTerms       String?      @db.Text
  receiptFooter      String?      @db.Text
  stampUrl           String?
  signatureUrl       String?
  authorizedPerson   String?
  organization       Organization @relation(fields: [organizationId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("dharamshala_settings")
}

model AccommodationRule {
  id             String       @id @default(cuid())
  organizationId String
  roomOrHallId   String?
  ruleType       String // e.g. JAIN_ONLY, NO_PETS
  notes          String?      @db.Text
  organization   Organization @relation(fields: [organizationId], references: [id])
  roomOrHall     RoomOrHall?  @relation(fields: [roomOrHallId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("accommodation_rules")
}

model EventHall {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  price          Decimal? @db.Decimal(12, 2)
  roomCount      Int      @default(0)
  foodAvailable  Boolean  @default(false)
  facilities     String?
  images         Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  bookings     EventHallBooking[]

  @@map("event_halls")
}

model EventHallBooking {
  id              String        @id @default(cuid())
  eventHallId     String
  memberId        String
  bookingDate     DateTime
  timeSlot        String?
  status          BookingStatus @default(SUBMITTED)
  amountPaid      Decimal?      @db.Decimal(12, 2)
  guestCount      Int           @default(1)
  specialRequests String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  eventHall EventHall @relation(fields: [eventHallId], references: [id])
  member    Member    @relation(fields: [memberId], references: [id])

  @@map("event_hall_bookings")
}
