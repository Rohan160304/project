  contactPerson   String?
  contactMobile   String?
  status          String       @default("ACTIVE")
  notes           String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  monkIds         Json?
  sponsorIds      Json?
  images          Json?
  links           Json?
  year            Int?
  monk            MonkProfile? @relation(fields: [monkId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("chaturmas_plans")
}

/// User-submitted feedback/suggestions from the mobile app
model UserFeedback {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  userName       String?
  category       String        @default("Application")
  comment        String
  status         String        @default("PENDING")
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@map("user_feedback")
}

/// User-flagged incorrect information reports (temple/monk info corrections)
model IncorrectReport {
  id             String        @id @default(cuid())
  organizationId String?
  reporterId     String?
  reporterName   String?
  entityType     String
  entityId       String?
  entityName     String?
  flaggedField   String
  currentValue   String?
  correctedValue String
  status         String        @default("PENDING")
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])
  reporter       User?         @relation("IncorrectReportReporter", fields: [reporterId], references: [id])

  @@index([organizationId])
  @@map("incorrect_reports")
}

/// Promotional banners shown on the mobile app home screen
model AppBanner {
  id           String    @id @default(cuid())
  title        String
  imageUrl     String
  redirectUrl  String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  deviceType   String    @default("MOBILE")
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?

  @@map("app_banners")
}

/// Dynamic home screen layout sections for the mobile app
model AppHomeSection {
  id           String    @id @default(cuid())
  name         String
  sectionType  String    @default("Carousel")
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  config       Json?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?

  @@map("app_home_sections")
}

/// Subscription plans available to partner organizations
model SubscriptionPlan {
  id          String    @id @default(cuid())
  name        String
  price       Float     @default(0)
  currency    String    @default("INR")
  duration    String    @default("Monthly")
  isActive    Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?
  features    Json

  @@map("subscription_plans")
}

/// Manual vihar location updates logged by temple admins for monks without GPS
model ManualTrackingEntry {
  id           String       @id @default(cuid())
  monkId       String?
  monkPublicId String?
  monkName     String
  stationName  String
  notes        String?
  loggedById   String?
  loggedAt     DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  monk         MonkProfile? @relation(fields: [monkId], references: [id])

  @@index([monkId])
  @@map("manual_tracking_entries")
}

model BhojanshalaPass {
  id              String                @id @default(cuid())
  publicId        String                @unique
  organizationId  String
  memberId        String
  mealType        MealType
  date            DateTime
  numberOfPersons Int                   @default(1)
  totalAmount     Decimal               @default(0) @db.Decimal(12, 2)
  status          BhojanshalaPassStatus @default(BOOKED)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  scans           BhojanshalaPassScan[]
  member          Member                @relation(fields: [memberId], references: [id])
  organization    Organization          @relation(fields: [organizationId], references: [id])

  @@index([organizationId, date])
  @@index([memberId])
  @@map("bhojanshala_passes")
}

model BhojanshalaPassScan {
  id          String          @id @default(cuid())
  passId      String
  scannedById String
  scannedAt   DateTime        @default(now())
  deviceInfo  Json?
  pass        BhojanshalaPass @relation(fields: [passId], references: [id])
  scannedBy   User            @relation(fields: [scannedById], references: [id])

  @@map("bhojanshala_pass_scans")
}

model BhojanshalaMenuItem {
  id             String       @id @default(cuid())
  organizationId String
  mealType       MealType
  itemName       String
  description    String?
  isAvailable    Boolean      @default(true)
  price          Decimal?     @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  dayOfWeek      String
  endTime        String?
  startTime      String?
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, mealType, dayOfWeek])
  @@map("bhojanshala_menu_items")
}

