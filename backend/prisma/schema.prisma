generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IdSequence {
  prefix    String @id
  lastValue Int    @default(107)

  @@map("id_sequences")
}

/// Auth identity — deliberately separate from Member/Staff/Admin profile data.
model User {
  id                   String                   @id @default(cuid())
  publicId             String?                  @unique
  mobile               String                   @unique
  mobileVerifiedAt     DateTime?
  whatsapp             String?
  whatsappVerifiedAt   DateTime?
  email                String?                  @unique
  emailVerifiedAt      DateTime?
  passwordHash         String?
  firstName            String?
  lastName             String?
  photoUrl             String?
  primaryRoleKey       RoleKey                  @default(MEMBER)
  status               UserStatus               @default(PENDING_OTP)
  preferredLanguage    String                   @default("English")
  lastLoginAt          DateTime?
  createdByAdmin       Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  deletedAt            DateTime?
  deletedById          String?
  failedLoginAttempts  Int                      @default(0)
  lockoutUntil         DateTime?
  createdById          String?
  auditLogs            AuditLog[]
  bhojanshalaPassScans BhojanshalaPassScan[]
  incorrectReports     IncorrectReport[]        @relation("IncorrectReportReporter")
  loginHistory         LoginHistory[]
  member               Member?
  notificationLogs     NotificationLog[]
  staff                Staff?
  devices              UserDevice[]
  feedbacks            UserFeedback[]
  userOrganizations    UserOrganization[]
  permissionOverrides  UserPermissionOverride[]
  createdBy            User?                    @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers         User[]                   @relation("UserCreatedBy")
  feedPosts            FeedPost[]               @relation("AuthorFeedPosts")

  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  key         RoleKey          @unique
  name        String
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]

  @@map("roles")
}

/// Default permission matrix per role, per module. Super Admin CRUDs this.
model RolePermission {
  id        String           @id @default(cuid())
  roleId    String
  module    String
  action    PermissionAction
  allowed   Boolean          @default(true)
  createdAt DateTime         @default(now())
  role      Role             @relation(fields: [roleId], references: [id])

  @@unique([roleId, module, action])
  @@map("role_permissions")
}

/// Per-user, per-organization overrides layered on top of role defaults.
model UserPermissionOverride {
  id             String           @id @default(cuid())
  userId         String
  organizationId String?
  module         String
  action         PermissionAction
  allowed        Boolean
  createdById    String?
  createdAt      DateTime         @default(now())
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId, module, action])
  @@map("user_permission_overrides")
}

/// Scopes an admin/staff user to one or more organizations (tenant isolation).
model UserOrganization {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  roleKey        RoleKey
  assignedById   String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
  @@map("user_organizations")
}

model UserDevice {
  id               String     @id @default(cuid())
  userId           String
  deviceId         String
  deviceType       DeviceType
  os               String?
  appVersion       String?
  ip               String?
  refreshTokenHash String?
  isRevoked        Boolean    @default(false)
  lastActiveAt     DateTime   @default(now())
  createdAt        DateTime   @default(now())
  user             User       @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
  @@map("user_devices")
}

model LoginHistory {
  id                String   @id @default(cuid())
  userId            String?
  mobile            String
  deviceId          String?
  ip                String?
  success           Boolean
  reason            String?
  flaggedSuspicious Boolean  @default(false)
  createdAt         DateTime @default(now())
  user              User?    @relation(fields: [userId], references: [id])

  @@index([mobile])
  @@map("login_history")
}

/// Immutable audit trail (§4.4). No update/delete on this model from the API.
model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  publicId       String?
  roleKey        RoleKey?
  organizationId String?
  module         String
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  deviceInfo     Json?
  isCritical     Boolean  @default(false)
  createdAt      DateTime @default(now())
  diff           Json?
  ipAddress      String?
  userAgent      String?
  user           User?    @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([module, action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Community {
  id             String         @id @default(cuid())
  name           String         @unique
  createdAt      DateTime       @default(now())
  deletedAt      DateTime?
  members        Member[]
  monks          MonkProfile[]
  organizations  Organization[]
  subCommunities SubCommunity[]

  @@map("communities")
}

model SubCommunity {
  id            String         @id @default(cuid())
  communityId   String
  name          String
  deletedAt     DateTime?
  gacchas       Gaccha[]
  members       Member[]
  monks         MonkProfile[]
  organizations Organization[]
  community     Community      @relation(fields: [communityId], references: [id])

  @@unique([communityId, name])
  @@map("sub_communities")
}

/// The 83-item Gaccha master list (seeded).
model Gaccha {
  id             String         @id @default(cuid())
  subCommunityId String
  name           String
  deletedAt      DateTime?
  subCommunity   SubCommunity   @relation(fields: [subCommunityId], references: [id])
  members        Member[]
  monks          MonkProfile[]
  organizations  Organization[]

  @@unique([subCommunityId, name])
  @@map("gacchas")
}

model TithiCalendarType {
  id                String                  @id @default(cuid())
  name              String                  @unique
  deletedAt         DateTime?
  members           Member[]
  organizations     Organization[]
  entries           TithiCalendarEntry[]
  correctionTickets TithiCorrectionTicket[]

  @@map("tithi_calendar_types")
}

model TithiCalendarEntry {
  id             String            @id @default(cuid())
  calendarTypeId String
  year           Int
  gregorianDate  DateTime
  tithiName      String
  description    String?
  createdAt      DateTime          @default(now())
  calendarType   TithiCalendarType @relation(fields: [calendarTypeId], references: [id])

  @@unique([calendarTypeId, gregorianDate])
  @@index([calendarTypeId, year])
  @@map("tithi_calendar_entries")
}

model TithiCorrectionTicket {
  id             String              @id @default(cuid())
  raisedByOrgId  String?
  calendarTypeId String
  date           DateTime
  issue          String
  status         TicketStatusGeneric @default(OPEN)
  resolution     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  calendarType   TithiCalendarType   @relation(fields: [calendarTypeId], references: [id])
  raisedByOrg    Organization?       @relation(fields: [raisedByOrgId], references: [id])

  @@map("tithi_correction_tickets")
}

model BhagwanMaster {
  id            String         @id @default(cuid())
  name          String         @unique
  imageUrl      String?
  deletedAt     DateTime?
  category      String         @default("Others")
  organizations Organization[]

  @@map("bhagwan_master")
}

model BookingCategory {
  id           String        @id @default(cuid())
  name         String        @unique
  deletedAt    DateTime?
  bookingItems BookingItem[]

  @@map("booking_categories")
}

model EventCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  deletedAt DateTime?
  events    Event[]

  @@map("event_categories")
}

model FeedCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  deletedAt DateTime?
  posts     FeedPost[]

  @@map("feed_categories")
}

model OfferCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  deletedAt DateTime?
  offers    Offer[]

  @@map("offer_categories")
}

model NewsCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  deletedAt DateTime?
  news      News[]

  @@map("news_categories")
}

model CommunityPageCategory {
  id        String          @id @default(cuid())
  name      String          @unique
  deletedAt DateTime?
  pages     CommunityPage[]

  @@map("community_page_categories")
}

model SponsorCategory {
  id           String        @id @default(cuid())
  name         String        @unique
  deletedAt    DateTime?
  tourSponsors TourSponsor[]

  @@map("sponsor_categories")
}

model StaffDepartment {
  id           String             @id @default(cuid())
  name         String             @unique
  deletedAt    DateTime?
  staff        Staff[]
  designations StaffDesignation[]

  @@map("staff_departments")
}

model StaffDesignation {
  id           String          @id @default(cuid())
  departmentId String
  name         String
  deletedAt    DateTime?
  staff        Staff[]
  department   StaffDepartment @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, name])
  @@map("staff_designations")
}

model VolunteerArea {
  id            String                 @id @default(cuid())
  name          String                 @unique
  deletedAt     DateTime?
  opportunities VolunteerOpportunity[]

  @@map("volunteer_areas")
}

model DonationCategory {
  id        String                  @id @default(cuid())
  name      String                  @unique
  deletedAt DateTime?
  splits    DonationCategorySplit[]

  @@map("donation_categories")
}

model RelationshipType {
  id          String         @id @default(cuid())
  name        String         @unique
  deletedAt   DateTime?
  familyLinks FamilyMember[]

  @@map("relationship_types")
}

model FacilityMaster {
  id        String    @id @default(cuid())
  name      String    @unique
  deletedAt DateTime?

  @@map("facility_master")
}

model CounterType {
  id             String           @id @default(cuid())
  name           String           @unique
  deletedAt      DateTime?
  subTypes       CounterSubType[]
  memberCounters MemberCounter[]

  @@map("counter_types")
}

model CounterSubType {
  id             String          @id @default(cuid())
  counterTypeId  String
  name           String
  deletedAt      DateTime?
  counterType    CounterType     @relation(fields: [counterTypeId], references: [id])
  memberCounters MemberCounter[]

  @@unique([counterTypeId, name])
  @@map("counter_sub_types")
}

model TourCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  deletedAt DateTime?
  tours     Tour[]

  @@map("tour_categories")
}

/// Polymorphic organization core reused by Temples/JCs/Dharamshalas/Bhojanshala/
/// Community Halls/Trust Offices so bookings/visitors/staff/donations share one FK.
model Organization {
  id                         String                     @id @default(cuid())
  publicId                   String                     @unique
  type                       OrganizationType
  name                       String
  shortName                  String?
  trustName                  String?
  trustRegistrationNumber    String?
  status                     OrganizationStatus         @default(ACTIVE)
  logoUrl                    String?
  coverUrl                   String?
  communityId                String?
  subCommunityId             String?
  communityPageId            String?
  gacchaId                   String?
  mulNayakBhagwanId          String?
  mulNayakImageUrl           String?
  muritCount                 Int?
  templeType                 TempleType?
  tithiCalendarTypeId        String?
  history                    String?
  addressLine                String?
  city                       String?
  state                      String?
  country                    String?
  pincode                    String?
  lat                        Float?
  lng                        Float?
  googleMapsLink             String?
  facilities                 Json?
  activeModules              String[]                   @default([])
  hasUpashray                Boolean                    @default(false)
  hasEventHall               Boolean                    @default(false)
  eventHallBookable          Boolean                    @default(false)
  hasBhojanshala             Boolean                    @default(false)
  bhojanshalaName            String?
  bhojanshalaPublished       Boolean                    @default(false)
  hasDharamshala             Boolean                    @default(false)
  dharamshalaPublished       Boolean                    @default(false)
  hasPathshala               Boolean                    @default(false)
  pathshalaPublished         Boolean                    @default(false)
  bankAccountEncrypted       String?
  bankIfsc                   String?
  upiId                      String?
  is80gEligible              Boolean                    @default(false)
  csrEligible                Boolean                    @default(false)
  donationQrUrl              String?
  disclaimerText             String?
  avgRating                  Float                      @default(0)
  followersCount             Int                        @default(0)
  createdById                String?
  updatedById                String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  deletedAt                  DateTime?
  deletedById                String?
  staffEarlyExitBefore       String?
  staffLateArrivalAfter      String?
  staffWorkingHoursEnd       String?
  staffWorkingHoursStart     String?
  upashrayLocation           String?
  eventHallPurpose           String?
  eventHallImages            Json?
  eventHallBookingItemId     String?
  sect                       String?
  subSect                    String?
  gacchaName                 String?
  preferredCurrency          String?
  morningStart               String?
  morningEnd                 String?
  eveningStart               String?
  eveningEnd                 String?
  pakshalStart               String?
  pakshalEnd                 String?
  poojaStart                 String?
  poojaEnd                   String?
  aartiMorning               String?
  aartiEvening               String?
  dharamshalaRooms           String?
  dharamshalaOffice          String?
  dharamshalaPhone           String?
  dharamshalaContact         String?
  dharamshalaContactMemberId String?
  dharamshalaOnline          String?
  receiptConfig              Json?
  pathshalaTimings           String?
  pathshalaDays              String?
  pathshalaTeacher           String?
  pathshalaTeacherMemberId   String?
  bhojanshalaBreakfastCharge String?
  bhojanshalaBreakfastTiming String?
  bhojanshalaLunchCharge     String?
  bhojanshalaLunchTiming     String?
  bhojanshalaDinnerCharge    String?
  bhojanshalaDinnerTiming    String?
  bhojanshalaContact         String?
  bhojanshalaContactMemberId String?
  bhojanshalaMealType        String?
  bhojanshalaAvailability    String?
  bankAccountName            String?
  bankName                   String?
  bankBranch                 String?
  landmark                   String?
  railwayStation             String?
  district                   String?
  hasTempleInside            Boolean                    @default(false)
  templeMulNayakName         String?
  templeMulNayakImageUrl     String?
  templeTithiCalendar        String?
  templeOpeningHours         String?
  templePakshalStart         String?
  templePoojaStart           String?
  templeAartiEvening         String?
  checkInTime                String?
  checkOutTime               String?
  advanceBookingRequired     Boolean                    @default(false)
  onlineBookingAvailable     Boolean                    @default(false)
  dharamshalaStatus          String?
  adminBlockedRooms          String?
  emergencyContact           String?
  caretakerDetails           String?
  rulesText                  String?
  primaryContactMemberId     String?
  secondaryContactMemberId   String?
  contactEmail               String?
  contactMobileVerified      Boolean                    @default(false)
  contactWhatsAppVerified    Boolean                    @default(false)
  contactEmailVerified       Boolean                    @default(false)
  primaryContactPreference   String?
  donationQrCodeUrl          String?
  instaLink                  String?
  facebookLink               String?
  youtubeLink                String?
  establishedDate            DateTime?
  timeline                   Json?
  insideTempleType           TempleType?
  parentOrganizationId       String?
  announcements              Announcement[]
  bhojanshalaMenuItems       BhojanshalaMenuItem[]
  bhojanshalaPasses          BhojanshalaPass[]
  dharamshalaBookings        DharamshalaBooking[]
  pathshalaBookings          PathshalaBooking[]
  bookingItems               BookingItem[]
  bookingsAsOrg              Booking[]
  buildings                  Building[]
  chaturmasPlans             ChaturmasPlan[]
  dhajaRecords               DhajaRecord[]
  donations                  Donation[]
  events                     Event[]
  feedPosts                  FeedPost[]
  galleryAlbums              GalleryAlbum[]
  incorrectReports           IncorrectReport[]
  MonkProfile                MonkProfile[]              @relation("CurrentTemple")
  nirvanaMonks               MonkProfile[]              @relation("NirvanaTemple")
  news                       News[]
  communicationsFrom         OrgCommunication[]         @relation("CommFromOrg")
  communicationsTo           OrgCommunication[]         @relation("CommToOrg")
  faqs                       OrgFaq[]
  contacts                   OrganizationContact[]
  follows                    OrganizationFollow[]
  gallery                    OrganizationGalleryImage[]
  historyEvents              OrganizationHistoryEvent[]
  notices                    OrganizationNotice[]
  reviews                    OrganizationReview[]
  socialLinks                OrganizationSocialLink[]
  trustees                   OrganizationTrustee[]
  volunteers                 OrganizationVolunteer[]
  community                  Community?                 @relation(fields: [communityId], references: [id])
  gaccha                     Gaccha?                    @relation(fields: [gacchaId], references: [id])
  mulNayakBhagwan            BhagwanMaster?             @relation(fields: [mulNayakBhagwanId], references: [id])
  parentOrganization         Organization?              @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations         Organization[]             @relation("OrganizationHierarchy")
  subCommunity               SubCommunity?              @relation(fields: [subCommunityId], references: [id])
  communityPage              CommunityPage?             @relation(fields: [communityPageId], references: [id])
  tithiCalendarType          TithiCalendarType?         @relation(fields: [tithiCalendarTypeId], references: [id])
  staff                      Staff[]
  supportTickets             SupportTicket[]
  tithiTickets               TithiCorrectionTicket[]
  userFeedbacks              UserFeedback[]
  userOrganizations          UserOrganization[]
  permissionOverrides        UserPermissionOverride[]
  visitorEntries             VisitorEntry[]
  volunteerOpportunities     VolunteerOpportunity[]

  dharamshalaSettings DharamshalaSettings?
  accommodationRules  AccommodationRule[]
  eventHalls          EventHall[]

  @@index([type])
  @@index([lat, lng])
  @@map("organizations")
}

model OrganizationGalleryImage {
  id             String       @id @default(cuid())
  organizationId String
  imageUrl       String
  order          Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_gallery_images")
}

model OrganizationContact {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  role           String?
  otpVerifiedAt  DateTime?
  member         Member       @relation(fields: [memberId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_contacts")
}

model OrganizationTrustee {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  designation    String
  member         Member       @relation(fields: [memberId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_trustees")
}

model OrganizationVolunteer {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  area           String?
  member         Member       @relation(fields: [memberId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_volunteers")
}

model OrganizationHistoryEvent {
  id              String              @id @default(cuid())
  organizationId  String
  type            OrgHistoryEventType
  eventDate       DateTime?
  description     String?
  linkedMemberIds Json?
  organization    Organization        @relation(fields: [organizationId], references: [id])

  @@map("organization_history_events")
}

model DhajaRecord {
  id              String       @id @default(cuid())
  organizationId  String
  year            Int
  dhajaDate       DateTime?
  descriptionEn   String?
  descriptionHi   String?
  linkedMemberIds Json?
  status          DhajaStatus  @default(NOT_YET_FINALIZED)
  createdAt       DateTime     @default(now())
  dhajaOf         String?
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@map("dhaja_records")
}

model OrganizationReview {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  rating         Int
  comment        String?
  adminReply     String?
  isPublished    Boolean      @default(false)
  isHidden       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  deletedById    String?
  member         Member       @relation(fields: [memberId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, memberId])
  @@map("organization_reviews")
}

model OrganizationNotice {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  body           String
  isPinned       Boolean      @default(false)
  startDate      DateTime?
  endDate        DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_notices")
}

model OrganizationFollow {
  id             String       @id @default(cuid())
  organizationId String
  memberId       String
  createdAt      DateTime     @default(now())
  member         Member       @relation(fields: [memberId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, memberId])
  @@map("organization_follows")
}

model OrganizationSocialLink {
  id             String       @id @default(cuid())
  organizationId String
  platform       String
  url            String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_social_links")
}

model PathshalaCenter {
  id              String    @id @default(cuid())
  name            String
  addressLine     String?
  city            String?
  state           String?
  country         String?
  contactMemberId String?
  createdById     String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?
  contactMember   Member?   @relation(fields: [contactMemberId], references: [id])

  @@map("pathshala_centers")
}

model Building {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  deletedAt      DateTime?
  imageUrl       String?
  roomNumbers    Json?
  organization   Organization @relation(fields: [organizationId], references: [id])
  wings          Wing[]

  @@map("buildings")
}

model Wing {
  id         String       @id @default(cuid())
  buildingId String
  name       String
  floor      String?
  deletedAt  DateTime?
  rooms      RoomOrHall[]
  building   Building     @relation(fields: [buildingId], references: [id])

  @@map("wings")
}

model RoomOrHall {
  id                  String               @id @default(cuid())
  wingId              String
  name                String
  type                RoomType
  capacity            Int
  pricePerUnit        Decimal              @default(0) @db.Decimal(12, 2)
  currency            String               @default("INR")
  amenities           Json?
  images              Json?
  status              RoomStatus           @default(AVAILABLE)
  deletedAt           DateTime?
  roomNumber          String?
  viewType            String?
  bathroomType        String?
  bedType             String?
  extraMattressCount  Int?
  extraMattressCharge Decimal?             @default(0) @db.Decimal(12, 2)
  category            String?
  roomCount           Int?
  chargesType         String?
  deposit             Decimal?             @default(0) @db.Decimal(12, 2)
  attachedBathroom    String?
  wing                Wing                 @relation(fields: [wingId], references: [id])
  tourRoomAssignments TourRoomAssignment[]
  allocations         BookingAllocation[]
  rules               AccommodationRule[]

  @@map("rooms_and_halls")
}

model MonkProfile {
  id                    String                @id @default(cuid())
  publicId              String                @unique
  dikshaName            String
  photoUrl              String?
  gender                MonkGender
  dob                   DateTime?
  dobPlace              String?
  nameBeforeDiksha      String?
  bio                   String?
  dikshaDate            DateTime?
  dikshaPlace           String?
  dikshaGuruId          String?
  communityId           String?
  subCommunityId        String?
  gacchaId              String?
  currentTempleId       String?
  status                String                @default("ACTIVE")
  emergencyContact      Json?
  groupId               String?
  createdById           String?
  updatedById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  deletedById           String?
  assignedAdminId       String?
  chaturmasHistory      Json?
  health                Json?
  languages             Json?
  media                 Json?
  nirvanaDate           DateTime?
  nirvanaPlace          String?
  preDikshaFather       Json?
  preDikshaLocation     Json?
  preDikshaMother       Json?
  recognitions          Json?
  routine               Json?
  sanghContacts         Json?
  shortName             String?
  siblings              Json?
  socialLinks           Json?
  tapasya               Json?
  timeline              Json?
